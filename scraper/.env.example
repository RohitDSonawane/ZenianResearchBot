# Pinecone (required)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=research-abstracts
PINECONE_ENVIRONMENT=us-east-1
EMBEDDING_DIMENSION=384

# Ollama (local LLM for summarization)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma3:1b

# Ollama generation parameters
TEMPERATURE=0.3
MAX_TOKENS_FOR_SUMMARY=1000
TOP_P=0.9
TOP_K=40
OLLAMA_TIMEOUT=180

# Scraping
BASE_SEARCH_URL=https://link.springer.com/search?new-search=true&query=research&dateFrom=&dateTo=&sortBy=relevance
HEADLESS_MODE=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Timeouts (milliseconds for Playwright)
LAUNCH_TIMEOUT=60000
SCRAPING_TIMEOUT=90000

# Concurrency and rate limiting
CONCURRENCY_LIMIT=3
WAIT_BETWEEN_PAGES=5
WAIT_BETWEEN_ARTICLES=1.0

# Output paths
LOGS_DIR=logs
